// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

enum SharePermission {
  READ
  EDIT
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
  notes      Note[]
  otp        String?
  otpExpiredAt DateTime?

  folders Folder[]
  sharedNotes NoteShare[]
}

model Note {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  userId     Int?
  deletedAt  DateTime?


  folderId Int?
  folder   Folder? @relation(fields: [folderId], references:[id], onDelete: SetNull)
  shares  NoteShare[]
}

// fields: [noteId]	Uses the noteId field in the current model as the foreign key.
// references: [id]	Connects noteId to the id field in the Note model.
// onDelete: Cascade	If the referenced note is deleted, its related records are automatically deleted.

model NoteShare {
  id         Int   @id @default(autoincrement())
  noteId     Int
  note       Note  @relation(fields: [noteId], references:[id], onDelete: Cascade)
  userId     Int
  user        User  @relation(fields: [userId], references:[id], onDelete: Cascade)
  permission SharePermission @default(READ)
  created_at  DateTime @default(now())

  // Ensure a note cannot be shared with the same user twice
  @@unique([noteId, userId])
}

model Folder {
  id Int @id @default(autoincrement())
  name String
  userId Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user User @relation(fields: [userId], references:[id])
  notes Note[]
  

  @@unique([name, userId])
}

